# Copy to .env (git-ignored). Names and safe placeholders only: never real credentials,
# tokens or production endpoints.

# Where the saved session lives. Default: OS config dir (~/.config/hinge-cli/session.json
# or %APPDATA%\hinge-cli\session.json). Leave unset unless you need a non-default path.
HINGE_SESSION_FILE=

# Password-manager reference in place of a session file, e.g. op://Private/hinge/session
# or bw://hinge-session. When set, nothing is written to disk. See docs/auth.md.
HINGE_SESSION_REF=

# Only needed for `hinge doctor` and `hinge inspect` (Appium/WebDriverAgent exploration), not for tier/limits/auth.
HINGE_APPIUM_URL=http://127.0.0.1:4723
HINGE_UDID=
HINGE_BUNDLE_ID=co.hinge.mobile.ios
HINGE_TEAM_ID=
